# Build and generated preview output
/.artifacts/
/target/
/cargo-home/
/preview/pkg/
*.png
!crates/**/tests/fixtures/*.png

# Local media and level data. Keep only small asset notices and playback metadata.
/assets/images/*
!/assets/images/first-person/
/assets/images/first-person/*
!/assets/images/first-person/ASSET-NOTICES.md
!/assets/images/first-person/playback/
/assets/images/first-person/playback/*
!/assets/images/first-person/playback/manifest.json
/assets/sound/*
!/assets/sound/.gitkeep
/assets/music/*
!/assets/music/.gitkeep
/assets/levels/*
!/assets/levels/README.md
*.sog
*.splat
*.ksplat
*.spz
*.ply

# Local environment files, credentials, and key material at any depth.
.env*
*.env
*.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.credentials
id_rsa
id_ed25519
.ssh/
.aws/
secrets/
credentials/
credentials.json
credentials.*.json
service-account*.json
*[aA][pP][iI]*[kK][eE][yY]*

# Python bytecode
__pycache__/
*.py[cod]
