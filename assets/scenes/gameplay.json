{
  "version": 1,
  "name": "CounterSplat preview",
  "component_types": {
    "Skybox": {
      "storage": "native"
    },
    "UiElement": {
      "storage": "native"
    },
    "FrameCounter": {
      "storage": "native"
    },
    "PlayerCamera": {
      "storage": "native"
    },
    "PlayerControls": {
      "storage": "native"
    }
  },
  "resources": {
    "assets": {
      "level": {
        "kind": "sog_level",
        "uri": "/level/",
        "load": "streamable"
      },
      "example-sky": {
        "kind": "radiance_hdr",
        "uri": "../images/environments/kloppenheim_06_puresky_1k.hdr",
        "load": "preload"
      },
      "pause_menu": {
        "kind": "scene",
        "uri": "menu.json",
        "load": "preload"
      },
      "level_selector": {
        "kind": "scene",
        "uri": "level-selector.json",
        "load": "preload"
      }
    },
    "scripts": {
      "rotate-sky": {
        "language": "lua",
        "uri": "../scripts/rotate_sky.lua",
        "autoload": false,
        "load": "streamable"
      },
      "gameplay-navigation": {
        "language": "lua",
        "uri": "../scripts/gameplay_navigation.lua",
        "autoload": false,
        "load": "preload"
      },
      "player-controls": {
        "language": "lua",
        "uri": "../scripts/player_controls.lua",
        "autoload": false,
        "load": "preload"
      }
    },
    "preview": {
      "level_asset": "level",
      "skybox_entity": "skybox",
      "capacity": 300000,
      "rotate_z_180": true,
      "ui": {
        "animate": "animate",
        "sway": "sway",
        "reset": "reset",
        "limit_enabled": "limit_enabled",
        "frame_limit": "frame_limit",
        "sky_visible": "sky_visible",
        "sky_exposure": "sky_exposure",
        "sky_rotation": "sky_rotation",
        "counter": "counter",
        "graph": "graph",
        "graph_scale": "graph_scale",
        "back_to_levels": "back_to_levels"
      },
      "browser_scripts": [
        "gameplay-navigation",
        "player-controls"
      ],
      "player_spawn": "level"
    }
  },
